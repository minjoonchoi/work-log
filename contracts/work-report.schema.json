{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "body",
    "source_refs"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]+$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 208,
        "pattern": "^(session|part):[^\\s\\[\\]]+$"
      }
    }
  }
}
