{
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "review": {
      "type": "object", "additionalProperties": false, "required": ["required", "reason"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" }
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "input": {
      "type": "object"
    },
    "internal": {
      "type": "boolean"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "engine": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "fixture",
        "local"
      ]
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "agent_session_id",
        "turn_id"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "agent_session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "fixture": {
      "type": "object"
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "input_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {}
      }
    },
    {
      "required": [
        "task",
        "input"
      ],
      "properties": {
        "task": {},
        "input": {}
      }
    }
  ]
}
