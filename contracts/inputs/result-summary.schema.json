{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "sessions"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "sessions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "engine",
          "start_at",
          "end_at",
          "summary",
          "events"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "engine": {
            "type": "string",
            "minLength": 1
          },
          "start_at": {
            "type": "string",
            "minLength": 1
          },
          "end_at": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "event_at",
                "text"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "input",
                    "output",
                    "turn.failed",
                    "turn.interrupted"
                  ]
                },
                "event_at": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "events": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  }
}
