{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements",
    "categories"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "normal",
          "failure",
          "boundary",
          "recovery"
        ]
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
