{
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "source_files", "allowed_paths"],
  "properties": {
    "requirements": { "type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 100000 },
    "source_files": {
      "type": "array", "maxItems": 120,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "content": { "type": "string", "maxLength": 1000000 }
        }
      }
    },
    "allowed_paths": {
      "type": "array", "minItems": 1, "maxItems": 80, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "instructions": { "type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 100000 }
  }
}
