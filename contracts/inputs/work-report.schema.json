{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dates",
    "timezone",
    "report_type",
    "stage",
    "compact"
  ],
  "properties": {
    "dates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 366,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "engine",
          "agent_session_id",
          "work_item_id",
          "original_work_item_id",
          "work_item_title",
          "start_at",
          "end_at",
          "pending",
          "tags",
          "jira_refs",
          "summary",
          "events"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "engine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "agent_session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "work_item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "original_work_item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "work_item_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "start_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "end_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "pending": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "jira_refs": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "url"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000
          },
          "events": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "event_at",
                "text"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "input",
                    "output",
                    "turn.failed",
                    "turn.interrupted"
                  ]
                },
                "event_at": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "events": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "report_type": {
      "enum": [
        "work"
      ]
    },
    "stage": {
      "enum": [
        "sessions",
        "consolidate"
      ]
    },
    "compact": {
      "type": "boolean"
    },
    "parts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body",
          "session_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "session_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "sessions"
      ],
      "properties": {
        "stage": {
          "const": "sessions"
        },
        "sessions": {}
      },
      "not": {
        "required": [
          "parts"
        ],
        "properties": {
          "parts": {}
        }
      }
    },
    {
      "required": [
        "parts"
      ],
      "properties": {
        "stage": {
          "const": "consolidate"
        },
        "parts": {}
      },
      "not": {
        "required": [
          "sessions"
        ],
        "properties": {
          "sessions": {}
        }
      }
    }
  ]
}
